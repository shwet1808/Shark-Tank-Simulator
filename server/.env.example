# ── Server ─────────────────────────
# Render sets PORT automatically — do not override unless local dev
PORT=3000
NODE_ENV=development

# ── AI Providers ───────────────────
# Configure at least one provider key. The router tries the primary
# first, then fails over to the others on 429/network errors.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Which provider to try first: "openrouter" | "gemini" | "openai"
PRIMARY_AI_PROVIDER=openrouter

# ── CORS ───────────────────────────
# Set this to your Vercel frontend origin on Render.
# Separate multiple production/preview origins with commas.
CORS_ORIGIN=https://your-app.vercel.app

# ── Rate Limiting ──────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
